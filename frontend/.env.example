# Firebase Web App configuration (Project settings -> General -> Your apps)
# Copy this file to .env and fill in the values. Never commit .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Spring Boot API (browser-visible origin only — no secrets)
VITE_API_BASE_URL=http://localhost:8090

# Set to true only for local Firebase Auth Emulator testing
VITE_USE_AUTH_EMULATOR=false

# Razorpay public key id (secret stays on the server)
VITE_RAZORPAY_KEY_ID=

# Optional public contact address for the marketing contact form
VITE_CONTACT_EMAIL=
